# Copy this file to keystore.properties (same folder, project root) and fill
# in the real values for LOCAL builds. keystore.properties itself must NEVER
# be committed — it's already in .gitignore.
#
# For CI (GitHub Actions) you don't need this file at all: the same values
# are read from the KEYSTORE_FILE / KEYSTORE_PASSWORD / KEYSTORE_ALIAS /
# KEYSTORE_KEY_PASSWORD environment variables, which the workflow sets from
# GitHub Secrets (KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEYSTORE_ALIAS).

storeFile=keystore/hyperisland-debug.keystore
storePassword=CHANGE_ME
keyAlias=hyperisland
keyPassword=CHANGE_ME
